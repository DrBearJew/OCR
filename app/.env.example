APP_NAME=Dok OCR
ENVIRONMENT=dev
DEBUG=true

DATABASE_URL=postgresql+psycopg://dokocr:dokocr@postgres:5432/dokocr
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_WORKER_PREFETCH_MULTIPLIER=1
OCR_WORKER_CONCURRENCY=1
METADATA_WORKER_CONCURRENCY=2
MAINTENANCE_WORKER_CONCURRENCY=1
OCR_TASK_SOFT_TIME_LIMIT=300
OCR_TASK_TIME_LIMIT=360
OCR_MAX_RETRIES=2
TASK_LEASE_SECONDS=420

STORAGE_PATH=/data/storage
CONSUME_PATH=/data/consume
NGINX_CLIENT_MAX_BODY_SIZE=250m
MAX_UPLOAD_FILE_SIZE_MB=200
MAX_UPLOAD_BATCH_SIZE_MB=500
MAX_UPLOAD_FILES_PER_BATCH=50
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,webp,tif,tiff,txt,doc,docx,xls,xlsx,ppt,pptx,odt,ods,odp,rtf,eml,msg
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,image/webp,image/tiff,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.oasis.opendocument.text,application/vnd.oasis.opendocument.spreadsheet,application/vnd.oasis.opendocument.presentation,application/rtf,message/rfc822,application/vnd.ms-outlook
MAX_PDF_PAGES=100
THUMBNAIL_SIZE=420
STUCK_DOCUMENT_MINUTES=30

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
SECRET_KEY=change-me-before-real-use
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Dev/test default uses fake OCR. Set OCR_PROVIDER=paddle_vl for PaddleOCR-VL, ppocrv6 for fast OCR, or glm for GLM fallback.
OCR_PROVIDER=fake
GLM_LLAMACPP_BASE_URL=http://glm-llama:8080
GLM_MODEL_PATH=/llm-models/glm.gguf
GLM_MMPROJ_PATH=/llm-models/glm-mmproj.gguf

QWEN_LLAMACPP_BASE_URL=http://smart-proxy:8081/v1
QWEN_MODEL_PATH=metadata

LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0
LLM_METADATA_REFINEMENT_ENABLED=false

OCR_MAX_PAGES_PER_DOC=50
OCR_IMAGE_DPI=200
OCR_CONCURRENCY=1
OCR_MODE=redo
OCR_LANGUAGE=deu+eng
OCR_CLEANUP_MODE=none
OCR_DESKEW=true
OCR_ROTATE_PAGES=true
OCR_ROTATE_THRESHOLD=12
OCR_OUTPUT_TYPE=pdfa
OCR_MAX_IMAGE_PIXELS=40000000

INGESTION_POLL_INTERVAL_SECONDS=300
CONVERTERS_ENABLED=false
TIKA_BASE_URL=http://tika:9998
GOTENBERG_BASE_URL=http://gotenberg:3000

FRONTEND_ORIGIN=http://localhost:3001
PUBLIC_BASE_URL=http://localhost:3001
API_BASE_URL=/api
VITE_API_BASE_URL=
# Local Vite dev proxy target. Docker/nginx builds do not use this.
VITE_API_PROXY_TARGET=http://127.0.0.1:8001
# Optional local-dev only preview login when the API is down. Never enable in production.
VITE_ALLOW_DEMO_LOGIN=false
COOKIE_SECURE=false
TRUSTED_PROXY_HEADERS=true
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:5173
COMMAND_HOOKS_ENABLED=false
COMMAND_HOOKS_ALLOWED_COMMANDS=python,python3
HOOK_WEBHOOK_ALLOWED_HOSTS=

PADDLE_VL_LLAMACPP_BASE_URL=http://smart-proxy:8081/v1
PADDLE_VL_MODEL_PATH=paddleocr-vl
PADDLE_VL_MMPROJ_PATH=/llm-models/paddleocr-vl-mmproj.gguf

# Optional fast/simple OCR mode uses PP-OCRv6 medium through ONNX Runtime.
PPOCRV6_TIER=medium
PPOCRV6_ENGINE=onnxruntime
PPOCRV6_DEVICE=cpu
