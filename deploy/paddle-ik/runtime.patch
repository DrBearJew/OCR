+            std::ifstream file(path);
+            if (!file) throw std::runtime_error("missing template fixture");
+            const std::string source((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+            auto templates = common_chat_templates_ptr(common_chat_templates_init(nullptr, source));
+            common_chat_templates_inputs inputs;
+            common_chat_msg user;
+            user.role = "user";
+            user.content = "Extract invoice metadata.";
+            inputs.messages = {user};
+            inputs.use_jinja = true;
+            inputs.enable_thinking = true;
+            inputs.reasoning_format = COMMON_REASONING_FORMAT_AUTO;
+            for (const char * schema : {"{}", R"({"type":"object","properties":{"invoice_number":{"type":"object","properties":{"value":{"type":"string"}},"required":["value"],"additionalProperties":false}},"required":["invoice_number"],"additionalProperties":false})"}) {
+                inputs.json_schema = schema;
+                const auto result = common_chat_templates_apply(templates.get(), inputs);
+                if (result.grammar.empty()) throw std::runtime_error("schema grammar was ignored");
+                if (result.grammar_lazy) throw std::runtime_error("schema grammar must apply immediately, not wait for a tool trigger");
+                if (!result.supports_thinking) throw std::runtime_error("reasoning support was lost");
+            }
+            inputs.json_schema.clear();
+            if (!common_chat_templates_apply(templates.get(), inputs).grammar.empty()) {
+                throw std::runtime_error("plain chat unexpectedly constrained");
+            }
+        }
+        std::cout << "PASS: LFM2.5 and Gemma JSON mode, typed schema, reasoning, and unconstrained chat\n";
+        return 0;
+    } catch (const std::exception & error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
diff --git a/tests/test-mtmd-positions.cpp b/tests/test-mtmd-positions.cpp
new file mode 100644
index 0000000..06cda54
--- /dev/null
+++ b/tests/test-mtmd-positions.cpp
@@ -0,0 +1,158 @@
+#include "mtmd.h"
+#include "mtmd-helper-internal.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+static void check(bool ok, const char * message) {
+    if (!ok) {
+        fprintf(stderr, "%s\n", message);
+        std::exit(1);
+    }
+}
+
+static constexpr int nx = 30;
+static constexpr int ny = 41;
+static constexpr int n_tokens = nx * ny;
+static constexpr int n_embd = 5;
+static constexpr llama_pos base = 17;
+static constexpr llama_seq_id sequence = 23;
+
+static void check_batch(const llama_batch & view, const decode_embd_batch & owner,
+                        int offset, int count, bool mrope) {
+    check(view.n_tokens == count && view.token == nullptr, "view token metadata changed");
+    check(view.embd == owner.batch.embd + offset * n_embd, "view embedding pointer offset incorrect");
+    check(view.n_seq_id == owner.batch.n_seq_id + offset, "view n_seq_id pointer offset incorrect");
+    check(view.seq_id == owner.batch.seq_id + offset, "view seq_id pointer offset incorrect");
+    check(view.logits == owner.batch.logits + offset, "view logits pointer offset incorrect");
+    check(view.pos == (mrope ? owner.pos_view.data() : owner.pos.data() + offset),
+          "view position pointer incorrect");
+    check(owner.pos_view.size() == (mrope ? 4 * size_t(count) : 0), "view position plane size incorrect");
+
+    // Read the outer view at the decoder's 512-token microbatch boundaries.
+    // Expectations use global row/column formulas, independent of the producer's nested loops.
+    for (int begin = 0; begin < count; begin += 512) {
+        const int end = std::min(begin + 512, count);
+        for (int i = begin; i < end; ++i) {
+            const int global = offset + i;
+            check(view.n_seq_id[i] == 1 && view.seq_id[i] == owner.seq_id_0.data()
+                  && view.seq_id[i][0] == sequence, "view sequence metadata incorrect");
+            check(view.logits[i] == 0, "image view unexpectedly requests logits");
+            for (int d = 0; d < n_embd; ++d) {
+                check(view.embd[i * n_embd + d] == float(global * n_embd + d),
+                      "view embedding data offset incorrect");
+            }
+            if (mrope) {
+                check(view.pos[i] == base, "temporal plane incorrect");
+                check(view.pos[count + i] == base + global / nx, "row plane incorrect");
+                check(view.pos[2 * count + i] == base + global % nx, "column plane incorrect");
+                check(view.pos[3 * count + i] == 0, "unused fourth plane incorrect");
+            } else {
+                check(view.pos[i] == base + global, "scalar position changed");
+            }
+        }
+    }
+}
+
+static void test_batches(bool mrope) {
+    std::vector<float> embeddings(n_tokens * n_embd);
+    for (size_t i = 0; i < embeddings.size(); ++i) {
+        embeddings[i] = float(i);
+    }
+    decode_embd_batch batch(embeddings.data(), n_tokens, mrope ? 4 : 1, n_embd);
+    if (mrope) {
+        batch.set_position_mrope_2d(base, nx, ny, sequence);
+    } else {
+        batch.set_position_normal(base, sequence);
+    }
+    check(batch.pos.size() == size_t(n_tokens * (mrope ? 4 : 1)), "position allocation size incorrect");
+    check(batch.batch.pos == batch.pos.data(), "batch position pointer incorrect");
+    check(batch.seq_ids[n_tokens] == nullptr, "sequence pointer sentinel missing");
+    for (int i = 0; i < n_tokens; ++i) {
+        if (mrope) {
+            check(batch.pos[i] == base && batch.pos[n_tokens + i] == base + i / nx
+                  && batch.pos[2 * n_tokens + i] == base + i % nx
+                  && batch.pos[3 * n_tokens + i] == 0, "full image position planes incorrect");
+        } else {
+            check(batch.pos[i] == base + i, "full scalar positions changed");
+        }
+    }
+    check_batch(batch.get_view(0, n_tokens), batch, 0, n_tokens, mrope);
+    check_batch(batch.get_view(0, 1024), batch, 0, 1024, mrope);
+    check_batch(batch.get_view(1024, 206), batch, 1024, 206, mrope);
+}
+
+static mtmd::input_chunk_ptr image_chunk(int width, int height, bool mrope) {
+    json fixture = {
+        {"type", MTMD_INPUT_CHUNK_TYPE_IMAGE},
+        {"tokens_image", {{"nx", width}, {"ny", height}, {"use_mrope_pos", mrope}, {"id", "grid"}}}
+    };
+    return mtmd::input_chunk_ptr(mtmd_input_chunk_from_json(fixture));
+}
+
+static void check_image(const mtmd_input_chunk * chunk, int width, int height, bool mrope) {
+    check(mtmd_input_chunk_get_type(chunk) == MTMD_INPUT_CHUNK_TYPE_IMAGE, "image chunk type changed");
+    const auto * image = mtmd_input_chunk_get_tokens_image(chunk);
+    check(image != nullptr, "image tokens missing");
+    check(mtmd_image_tokens_get_nx(image) == size_t(width)
+          && mtmd_image_tokens_get_ny(image) == size_t(height), "merged 2D grid lost");
+    check(mtmd_image_tokens_get_n_tokens(image) == size_t(width * height)
+          && mtmd_input_chunk_get_n_tokens(chunk) == size_t(width * height), "image token count changed");
+    const llama_pos span = mrope ? std::max(width, height) : width * height;
+    check(mtmd_image_tokens_get_n_pos(image) == span, "image position span incorrect");
+    check(mtmd_input_chunk_get_n_pos(chunk) == span, "chunk position span incorrect");
+}
+
+static void test_chunk_positions() {
+    for (bool mrope : {false, true}) {
+        for (bool transpose : {false, true}) {
+            const int width = transpose ? ny : nx;
+            const int height = transpose ? nx : ny;
+            auto chunk = image_chunk(width, height, mrope);
+            check_image(chunk.get(), width, height, mrope);
+            mtmd::input_chunk_ptr copy(mtmd_input_chunk_copy(chunk.get()));
+            chunk.reset();
+            check_image(copy.get(), width, height, mrope);
+            // Cache interruption: geometry must survive raw-data release and JSON restore.
+            mtmd_input_chunk_free_raw_data(copy.get());
+            json saved;
+            mtmd_input_chunk_to_json(copy.get(), saved);
+            check(saved["tokens_image"]["use_mrope_pos"].is_boolean()
+                  && saved["tokens_image"]["use_mrope_pos"].get<bool>() == mrope, "MRoPE flag not preserved");
+            copy.reset();
+            mtmd::input_chunk_ptr restored(mtmd_input_chunk_from_json(saved));
+            check_image(restored.get(), width, height, mrope);
+        }
+
+        auto first = image_chunk(nx, ny, mrope);
+        auto second = image_chunk(ny, nx, mrope);
+        json text_fixture = {{"type", MTMD_INPUT_CHUNK_TYPE_TEXT}, {"tokens_text", {7, 8, 9}}};
+        mtmd::input_chunk_ptr text(mtmd_input_chunk_from_json(text_fixture));
+        llama_pos next = base;
+        next += mtmd_input_chunk_get_n_pos(first.get());
+        check(next == base + (mrope ? 41 : 1230), "second image start incorrect");
+        next += mtmd_input_chunk_get_n_pos(second.get());
+        check(next == base + (mrope ? 82 : 2460), "following text start incorrect");
+        float embeddings[3] = {};
+        decode_embd_batch text_positions(embeddings, 3, 1, 1);
+        text_positions.set_position_normal(next, sequence);
+        for (int i = 0; i < 3; ++i) {
+            check(text_positions.pos[i] == base + (mrope ? 82 : 2460) + i,
+                  "following text scalar positions incorrect");
+        }
+        check(mtmd_input_chunk_get_n_tokens(text.get()) == 3
+              && mtmd_input_chunk_get_n_pos(text.get()) == 3, "text position count changed");
+        next += mtmd_input_chunk_get_n_pos(text.get());
+        check(next == base + (mrope ? 85 : 2463), "two-image plus text advance incorrect");
+    }
+}
+
+int main() {
+    test_batches(true);
+    test_batches(false);
+    test_chunk_positions();
+    puts("PASS: four-plane MRoPE grids, 1024/206 views, 512 microbatch boundaries, scalar positions, clone/JSON, and following text");
+    return 0;
+}
diff --git a/tests/test-paddleocr.cpp b/tests/test-paddleocr.cpp
new file mode 100644
index 0000000..9b478d0
--- /dev/null
+++ b/tests/test-paddleocr.cpp
@@ -0,0 +1,389 @@
+#include "../src/llama-model.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+// IQK is optional and its build defines are private to ggml. Inspect the existing
+// dispatcher on ELF builds without making non-IQK test builds depend on it.
+#if defined(__ELF__) && defined(__GNUC__)
+#include "../ggml/src/iqk/iqk_mul_mat.h"
+#pragma weak iqk_flash_attn_noalibi
+#pragma weak iqk_mul_mat
+#define TEST_IQK_DISPATCH
+#endif
+
+static void check(bool ok, const char * message) {
+    if (!ok) {
+        fprintf(stderr, "%s\n", message);
+        std::exit(1);
+    }
+}
+
+static void close(float actual, double expected, double tolerance, const char * message) {
+    if (!std::isfinite(actual) || std::abs(actual - expected) > tolerance) {
+        fprintf(stderr, "%s: got %.9g, expected %.9g\n", message, actual, expected);
+        std::exit(1);
+    }
+}
+
+static ggml_context * context() {
+    return ggml_init({16 * 1024 * 1024, nullptr, false});
+}
+
+static void compute(ggml_context * ctx, ggml_tensor * out, int threads) {
+    auto * graph = ggml_new_graph(ctx);
+    ggml_build_forward_expand(graph, out);
+    check(ggml_graph_compute_with_ctx(ctx, graph, threads) == GGML_STATUS_SUCCESS, "graph compute failed");
+}
+
+static bool test_bf16_matmul(int k, int nx, int ny, int threads, bool tail_only) {
+    auto * ctx = context();
+    auto * a = ggml_new_tensor_2d(ctx, GGML_TYPE_BF16, k, nx);
+    auto * b = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, ny);
+    auto * av = static_cast<ggml_bf16_t *>(a->data);
+    auto * bv = static_cast<float *>(b->data);
+    std::vector<ggml_bf16_t> bf16_b(k*ny);
+    // Isolate the previously dropped 8/16 terms, including the aligned control.
+    const int tail = k % 32 ? k % 32 : 16;
+    for (int i = 0; i < nx; ++i) for (int d = 0; d < k; ++d) {
+        const float value = tail_only ? float(d >= k - tail) : float((i + 3*d)%5 - 2);
+        av[i*k + d] = ggml_fp32_to_bf16(value);
+    }
+    for (int j = 0; j < ny; ++j) for (int d = 0; d < k; ++d) {
+        const float value = tail_only ? float(d >= k - tail) : float((2*j + d)%7 - 3);
+        bv[j*k + d] = value;
+        bf16_b[j*k + d] = ggml_fp32_to_bf16(value);
+    }
+    auto * out = ggml_mul_mat(ctx, a, b);
+    compute(ctx, out, threads); // Exercise the F32-activation conversion and normal fallback too.
+    const auto * result = static_cast<float *>(out->data);
+    std::vector<float> direct(nx*ny, -12345.0f);
+    bool accepted = false;
+#ifdef TEST_IQK_DISPATCH
+    if (iqk_mul_mat) {
+        for (int ith = 0; ith < threads; ++ith) {
+            const bool supported = iqk_mul_mat(nx, ny, k, GGML_TYPE_BF16, av, a->nb[1],
+                GGML_TYPE_BF16, bf16_b.data(), k*sizeof(ggml_bf16_t), direct.data(), nx, ith, threads);
+            if (ith == 0) accepted = supported;
+            check(supported == accepted, "IQK BF16 acceptance differs between workers");
+        }
+        if (!accepted) check(std::all_of(direct.begin(), direct.end(), [](float f) { return f == -12345.0f; }),
+            "rejected BF16 matmul wrote output");
+    }
+#endif
+    for (int j = 0; j < ny; ++j) for (int i = 0; i < nx; ++i) {
+        double expected = 0;
+        for (int d = 0; d < k; ++d) expected += double(ggml_bf16_to_fp32(av[i*k + d]))*bv[j*k + d];
+        // Small integer inputs and sums are exact in BF16/F32: no tolerance can hide a lost tail.
+        close(result[j*nx + i], expected, 0, "BF16 matmul scalar reference");
+        if (accepted) close(direct[j*nx + i], expected, 0, "IQK BF16 matmul scalar reference");
+    }
+    ggml_free(ctx);
+    return accepted;
+}
+
+static void test_dispatch() {
+    const auto arch = llm_arch_from_string("paddleocr");
+    check(arch == LLM_ARCH_PADDLEOCR, "Paddle architecture dispatch");
+    check(std::strcmp(llama_model_arch_name(arch), "paddleocr") == 0, "Paddle architecture name");
+    check(LLM_KV(arch)(LLM_KV_ROPE_DIMENSION_SECTIONS) == "paddleocr.rope.dimension_sections", "Paddle metadata namespace");
+    const LLM_TN tn(arch);
+    check(tn(LLM_TENSOR_ATTN_Q, "weight", 2) == "blk.2.attn_q.weight", "Paddle tensor namespace");
+    check(llm_tensor_type(arch, "blk.2.ffn_up.weight", 2) == LLM_TENSOR_FFN_UP, "Paddle tensor dispatch");
+    llama_model model;
+    model.arch = arch;
+    check(llama_rope_type(&model) == LLAMA_ROPE_TYPE_MROPE, "Paddle text RoPE dispatch");
+}
+
+static double sample(int x, int y, int channel, int batch) {
+    return x*x + 7*y*y + x*y + 100*channel + 1000*batch;
+}
+
+static void test_resize(int iw, int ih, int ow, int oh, int mode, bool align, int threads) {
+    auto * ctx = context();
+    // Match the non-contiguous [width, height, channels] view used by CLIP.
+    auto * storage = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, 3, iw, ih, 2);
+    auto * data = static_cast<float *>(storage->data);
+    for (int b = 0; b < 2; ++b)
+        for (int y = 0; y < ih; ++y)
+            for (int x = 0; x < iw; ++x)
+                for (int c = 0; c < 3; ++c)
+                    *data++ = sample(x, y, c, b);
+    auto * src = ggml_permute(ctx, storage, 2, 0, 1, 3);
+    auto * out = ggml_interpolate(ctx, src, ow, oh, 3, 2,
+        mode | (align ? GGML_SCALE_FLAG_ALIGN_CORNERS : 0));
+    compute(ctx, out, threads);
+    const double sx = align && iw > 1 && ow > 1 ? double(iw - 1)/(ow - 1) : double(iw)/ow;
+    const double sy = align && ih > 1 && oh > 1 ? double(ih - 1)/(oh - 1) : double(ih)/oh;
+    data = static_cast<float *>(out->data);
+    for (int b = 0; b < 2; ++b) {
+        for (int c = 0; c < 3; ++c) {
+            for (int y = 0; y < oh; ++y) {
+                for (int x = 0; x < ow; ++x) {
+                    double expected;
+                    if (mode == GGML_SCALE_MODE_NEAREST) {
+                        expected = sample(int(x*sx), int(y*sy), c, b);
+                    } else {
+                        double px = align ? x*sx : (x + 0.5)*sx - 0.5;
+                        double py = align ? y*sy : (y + 0.5)*sy - 0.5;
+                        px = std::max(0.0, std::min(px, double(iw - 1)));
+                        py = std::max(0.0, std::min(py, double(ih - 1)));
+                        const int x0 = int(px), y0 = int(py);
+                        const int x1 = std::min(x0 + 1, iw - 1), y1 = std::min(y0 + 1, ih - 1);
+                        const double dx = px - x0, dy = py - y0;
+                        expected = (1 - dy)*((1 - dx)*sample(x0, y0, c, b) + dx*sample(x1, y0, c, b))
+                                 + dy*((1 - dx)*sample(x0, y1, c, b) + dx*sample(x1, y1, c, b));
+                    }
+                    close(*data++, expected, 3e-4, "resize scalar reference");
+                }
+            }
+        }
+    }
+    ggml_free(ctx);
+}
+
+static void test_rope(bool vision, int threads) {
+    auto * ctx = context();
+    const int dim = vision ? 72 : 64;
+    const int n_rot = vision ? dim/2 : dim;
+    const int np = 6, nh = 2;
+    auto * src = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, dim, nh, np);
+    auto * pos = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 4*np);
+    auto * p = static_cast<int32_t *>(pos->data);
+    for (int i = 0; i < np; ++i) {
+        p[i] = vision ? i/3 : 7;
+        p[np + i] = vision ? i%3 : 7 + i/3;
+        p[2*np + i] = vision ? i/3 : 7 + i%3;
+        p[3*np + i] = vision ? i%3 : 0;
+    }
+    auto * x = static_cast<float *>(src->data);
+    for (int i = 0; i < dim*nh*np; ++i) x[i] = std::sin(i*0.13f);
+    int sections[4] = {vision ? 18 : 8, vision ? 18 : 12, vision ? 18 : 12, vision ? 18 : 0};
+    auto * out = ggml_rope_multi(ctx, src, pos, nullptr, n_rot, sections,
+        vision ? GGML_ROPE_TYPE_VISION : GGML_ROPE_TYPE_MROPE,
+        32768, 10000, 1, 0, 1, 32, 1);
+    compute(ctx, out, threads);
+    const auto * y = static_cast<float *>(out->data);
+    const int half = dim/2;
+    for (int i = 0; i < np; ++i) {
+        for (int h = 0; h < nh; ++h) {
+            const int row = dim*(h + nh*i);
+            for (int d = 0; d < half; ++d) {
+                const int axis = vision ? d/18 : (d < 8 ? 0 : d < 20 ? 1 : 2);
+                const int frequency = vision ? d%18 : d;
+                const double angle = p[axis*np + i]*std::pow(10000.0, -2.0*frequency/n_rot);
+                const double a = x[row + d], b = x[row + d + half];
+                close(y[row + d], a*std::cos(angle) - b*std::sin(angle), 3e-6, "RoPE first half");
+                close(y[row + d + half], a*std::sin(angle) + b*std::cos(angle), 3e-6, "RoPE second half");
+            }
+        }
+    }
+    ggml_free(ctx);
+}
+
+#ifdef TEST_IQK_DISPATCH
+static bool dispatch_attention(const ggml_tensor * q, const ggml_tensor * k, const ggml_tensor * v,
+        ggml_tensor * out, const void * mask, float scale, int ith, int nth,
+        float max_bias = 0, float softcap = 0, const void * sinks = nullptr, ggml_tensor * indexer = nullptr) {
+    return iqk_flash_attn_noalibi(q->type, GGML_TYPE_F16, max_bias,
+        q->ne[3], q->ne[2], q->nb[3], q->nb[2],
+        k->ne[3], k->ne[2], k->nb[3], k->nb[2],
+        v->ne[3], v->ne[2], v->nb[3], v->nb[2],
+        out->ne[2], out->ne[1], out->nb[1], k->type, v->type,
+        k->ne[0], v->ne[0], q->ne[1], k->ne[1], q->nb[1], k->nb[1], v->nb[1],
+        mask ? k->ne[1]*sizeof(ggml_fp16_t) : 0, q->data, k->data, v->data, mask, sinks,
+        scale, softcap, static_cast<float *>(out->data), nullptr, nullptr, nullptr, ith, nth, 0, indexer);
+}
+
+static bool has_iqk_attention() {
+    if (!ggml_cpu_has_avx2() || !iqk_flash_attn_noalibi) return false;
+    // The 96-wide masked F16 kernel predates the adapter. This distinguishes
+    // IQK FA being disabled from the adapter incorrectly rejecting a 72 case.
+    auto * ctx = context();
+    auto * q = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, 96, 1, 1, 1);
+    auto * k = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, 96, 32, 1, 1);
+    auto * v = ggml_dup_tensor(ctx, k);
+    auto * out = ggml_dup_tensor(ctx, q);
+    std::memset(q->data, 0, ggml_nbytes(q));
+    std::memset(k->data, 0, ggml_nbytes(k));
+    std::memset(v->data, 0, ggml_nbytes(v));
+    ggml_fp16_t mask[32] = {};
+    const bool supported = dispatch_attention(q, k, v, out, mask, 1, 0, 1);
+    ggml_free(ctx);
+    return supported;
+}
+
+static void test_attention_guards(const ggml_tensor * q, const ggml_tensor * k, const ggml_tensor * v,
+        ggml_tensor * out, float scale) {
+    std::vector<float> sentinel(ggml_nelements(out), -12345.0f);
+    for (int guard = 0; guard < 14; ++guard) {
+        ggml_tensor dst = *out;
+        dst.data = sentinel.data();
+        ggml_tensor qt = *q, kt = *k, vt = *v;
+        ggml_tensor indexer = {};
+        const void * mask = nullptr;
+        const void * sinks = nullptr;
+        float max_bias = 0, softcap = 0, test_scale = scale;
+        switch (guard) {
+            case 0: mask = sentinel.data(); break;
+            case 1: max_bias = 1; break;
+            case 2: max_bias = -1; break;
+            case 3: softcap = 1; break;
+            case 4: sinks = sentinel.data(); break;
+            case 5: break; // Even a non-I32 indexer is outside this adapter.
+            case 6: qt.type = GGML_TYPE_F16; break;
+            case 7: kt.type = GGML_TYPE_F32; break;
+            case 8: vt.type = GGML_TYPE_F32; break;
+            case 9: kt.ne[2] = 1; break; // GQA
+            case 10: vt.ne[3] = 1; break; // batch broadcast
+            case 11: dst.ne[1] = q->ne[2] + 1; break;
+            case 12: test_scale = 0; break;
+            case 13: test_scale = -scale; break;
+        }
+        for (int ith = 0; ith < 4; ++ith) {
+            check(!dispatch_attention(&qt, &kt, &vt, &dst, mask, test_scale, ith, 4,
+                max_bias, softcap, sinks, guard == 5 ? &indexer : nullptr), "ineligible D=72 dispatcher accepted");
+        }
+        check(std::all_of(sentinel.begin(), sentinel.end(), [](float f) { return f == -12345.0f; }),
+            "rejected attention wrote output");
+    }
+}
+#endif
+
+static void test_attention(int nq, int nk, int nh, int nb, bool interleaved, int threads,
+        bool iqk, int dim = 72, bool masked = false, float scale_factor = 1) {
+    auto * ctx = context();
+    // Gaps in feature storage and batch stride; Q/V interleave heads, K does not.
+    auto input = [&](ggml_type type, int nr, bool interleave) {
+        if (!interleaved) return ggml_new_tensor_4d(ctx, type, dim, nr, nh, nb);
+        auto * storage = ggml_new_tensor_4d(ctx, type, dim + 8, interleave ? nh : nr,
+            interleave ? nr + 1 : nh + 1, nb);
+        if (interleave) storage = ggml_permute(ctx, storage, 0, 2, 1, 3);
+        return ggml_view_4d(ctx, storage, dim, nr, nh, nb, storage->nb[1], storage->nb[2], storage->nb[3], 0);
+    };
+    auto * q = input(GGML_TYPE_F32, nq, true);
+    auto * k = input(GGML_TYPE_F16, nk, false);
+    auto * v = input(GGML_TYPE_F16, nk, true);
+    auto row = [](const ggml_tensor * t, int r, int h, int b) {
+        return static_cast<char *>(t->data) + r*t->nb[1] + h*t->nb[2] + b*t->nb[3];
+    };
+    for (int b = 0; b < nb; ++b) for (int h = 0; h < nh; ++h) {
+        for (int r = 0; r < nq; ++r) for (int d = 0; d < dim; ++d)
+            reinterpret_cast<float *>(row(q, r, h, b))[d] = std::sin((d + dim*(r + nq*(h + nh*b)))*0.17f);
+        for (int r = 0; r < nk; ++r) for (int d = 0; d < dim; ++d) {
+            int i = d + dim*(r + nk*(h + nh*b));
+            reinterpret_cast<ggml_fp16_t *>(row(k, r, h, b))[d] = ggml_fp32_to_fp16(std::cos(i*0.11f));
+            reinterpret_cast<ggml_fp16_t *>(row(v, r, h, b))[d] = ggml_fp32_to_fp16(std::sin(i*0.07f));
+        }
+    }
+    ggml_tensor * mask = nullptr;
+    if (masked) {
+        mask = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, nk, GGML_PAD(nq, GGML_KQ_MASK_PAD));
+        auto * m = static_cast<ggml_fp16_t *>(mask->data);
+        for (int r = 0; r < mask->ne[1]; ++r) for (int j = 0; j < nk; ++j)
+            m[r*nk + j] = ggml_fp32_to_fp16(j > r ? -INFINITY : 0);
+    }
+    const float scale = scale_factor/std::sqrt(float(dim));
+    auto * out = ggml_flash_attn_ext(ctx, q, k, v, mask, scale, 0, 0);
+    ggml_flash_attn_ext_set_prec(out, GGML_PREC_F32);
+    compute(ctx, out, threads);
+    const auto * result = static_cast<float *>(out->data);
+    std::vector<float> direct(ggml_nelements(out), -12345.0f);
+#ifdef TEST_IQK_DISPATCH
+    if (iqk) {
+        ggml_tensor dst = *out;
+        dst.data = direct.data();
+        for (int ith = 0; ith < threads; ++ith) {
+            check(dispatch_attention(q, k, v, &dst, mask ? mask->data : nullptr, scale, ith, threads),
+                "eligible attention dispatcher rejected");
+            for (int b = 0; b < nb; ++b) for (int r = 0; r < nq; ++r) for (int h = 0; h < nh; ++h) {
+                if (dim == 72 && (b*nh + h)%threads > ith) {
+                    check(direct[dim*(h + nh*(r + nq*b))] == -12345.0f, "dispatcher wrote another worker's head");
+                }
+            }
+        }
+        if (dim == 72 && nh == 2 && nb == 2) test_attention_guards(q, k, v, out, scale);
+    }
+#endif
+    // Also exercise CLIP's non-flash F32 attention path with the same inputs.
+    auto * kq = ggml_mul_mat(ctx, ggml_cast(ctx, k, GGML_TYPE_F32), q);
+    auto * float_mask = mask ? ggml_cast(ctx, mask, GGML_TYPE_F32) : nullptr;
+    kq = ggml_soft_max_ext(ctx, kq, float_mask, scale, 0);
+    auto * vt = ggml_cont(ctx, ggml_transpose(ctx, ggml_cast(ctx, v, GGML_TYPE_F32)));
+    auto * plain = ggml_mul_mat(ctx, vt, kq);
+    compute(ctx, plain, threads);
+    const auto * plain_result = static_cast<float *>(plain->data);
+    std::vector<double> scores(nk);
+    for (int b = 0; b < nb; ++b) for (int h = 0; h < nh; ++h) {
+        for (int iq = 0; iq < nq; ++iq) {
+            double maximum = -INFINITY, sum = 0;
+            for (int ik = 0; ik < nk; ++ik) {
+                double dot = 0;
+                for (int d = 0; d < dim; ++d) {
+                    dot += double(reinterpret_cast<float *>(row(q, iq, h, b))[d]) *
+                        ggml_fp16_to_fp32(reinterpret_cast<ggml_fp16_t *>(row(k, ik, h, b))[d]);
+                }
+                scores[ik] = masked && ik > iq ? -INFINITY : dot*scale;
+                maximum = std::max(maximum, scores[ik]);
+            }
+            for (double & score : scores) { score = std::exp(score - maximum); sum += score; }
+            for (int d = 0; d < dim; ++d) {
+                double expected = 0;
+                for (int ik = 0; ik < nk; ++ik)
+                    expected += scores[ik]*ggml_fp16_to_fp32(reinterpret_cast<ggml_fp16_t *>(row(v, ik, h, b))[d])/sum;
+                const int index = d + dim*(h + nh*(iq + nq*b));
+                close(result[index], expected, 2e-3, "flash attention scalar reference");
+                if (iqk) close(direct[index], expected, 3e-6, "IQK attention scalar reference");
+                close(plain_result[d + dim*(iq + nq*(h + nh*b))], expected, 3e-6, "non-flash attention scalar reference");
+            }
+        }
+    }
+    ggml_free(ctx);
+}
+
+int main(int argc, char ** argv) {
+    test_dispatch();
+    bool iqk = false;
+#ifdef TEST_IQK_DISPATCH
+    iqk = has_iqk_attention();
+#endif
+    if (argc == 2 && std::strcmp(argv[1], "--require-iqk") == 0) check(iqk, "IQK attention unavailable");
+    printf("IQK dispatcher checks: %s\n", iqk ? "enabled" : "unavailable (graph references only)");
+    printf("BF16 matmul AVX512BF16 build: %s\n", ggml_cpu_has_avx512_bf16() ? "yes" : "no");
+    for (int k : {32, 40, 48, 4304}) {
+        int accepted = 0, cases = 0;
+        const int shapes[][2] = {{32, 16}, {7, 3}, {65, 17}, {1, 1}};
+        for (int threads : {1, 2, 4}) for (const auto & shape : shapes) for (bool tail_only : {true, false}) {
+            accepted += test_bf16_matmul(k, shape[0], shape[1], threads, tail_only);
+            ++cases;
+        }
+        printf("BF16 k=%d exact references passed, IQK direct accepted %d/%d cases\n", k, accepted, cases);
+    }
+    for (int threads : {1, 2, 4}) {
+        test_rope(false, threads);
+        test_rope(true, threads);
+        test_attention(7, 7, 2, 1, false, threads, iqk);
+        test_attention(113, 113, 2, 1, false, threads, iqk);
+        for (int nk : {31, 32, 33, 113}) {
+            test_attention(9, nk, 2, 2, true, threads, iqk, 72, false, 0.73f);
+            test_attention(3, nk, 1, 1, true, threads, iqk); // Idle workers.
+        }
+        test_attention(7, 32, 2, 1, true, threads, iqk, 64, true); // Existing masked/text kernel.
+        for (bool align : {false, true}) {
+            for (int mode : {GGML_SCALE_MODE_NEAREST, GGML_SCALE_MODE_BILINEAR}) {
+                test_resize(2, 3, 5, 7, mode, align, threads);
+                test_resize(5, 7, 2, 3, mode, align, threads);
+                test_resize(3, 2, 3, 2, mode, align, threads);
+                test_resize(1, 3, 4, 1, mode, align, threads);
+                test_resize(3, 1, 1, 4, mode, align, threads);
+            }
+        }
+        // At integer coordinates bicubic must preserve endpoints.
+        test_resize(3, 3, 2, 2, GGML_SCALE_MODE_BICUBIC, true, threads);
+    }
+    puts("Paddle dispatch, RoPE, D=72 attention and resize references passed");
+}
