# Dok OCR app env fragment for PaddleOCR-VL via llama-swap + ik OpenVINO managed sidecar.
# Merge these values into app/.env, or save equivalent values in Admin -> Model Setup.

OCR_PROVIDER=paddle_vl

# These URLs assume the runtime shares the app's Compose network.
# For a host-managed gateway, substitute an address reachable from your own
# Docker network and restrict its listener/firewall to trusted clients.
PADDLE_VL_LLAMACPP_BASE_URL=http://model-runtime:8092/v1
PADDLE_VL_MODEL_PATH=paddleocr-vl
PADDLE_VL_MMPROJ_PATH=/llm-models/paddleocr-vl-mmproj.gguf

# Metadata/Qwen also goes directly to Dok OCR llama-swap; customization and
# output cleanup live in the Dok OCR backend, not in smart-proxy.
LLM_METADATA_REFINEMENT_ENABLED=true
QWEN_LLAMACPP_BASE_URL=http://model-runtime:8092/v1
QWEN_MODEL_PATH=metadata

# Optional GLM fallback OCR also points at Dok OCR llama-swap.
GLM_LLAMACPP_BASE_URL=http://model-runtime:8092/v1
GLM_MODEL_PATH=glm
GLM_MMPROJ_PATH=/llm-models/glm-mmproj.gguf

# Tune task ceilings against measured page latency on your hardware.
# The app supports bounded parallel page requests without a batch endpoint.
OCR_TASK_SOFT_TIME_LIMIT=600
OCR_TASK_TIME_LIMIT=660
OCR_TASK_BASE_OVERHEAD_SECONDS=300
OCR_TASK_PADDLE_VL_SECONDS_PER_CHUNK=180
