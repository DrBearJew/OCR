+    static void resize_glm4v(const clip_image_u8 & src, clip_image_u8 & dst, clip_image_size size) {
+        GGML_ASSERT(src.nx > 0 && src.ny > 0 && size.width > 0 && size.height > 0);
+        dst.nx = size.width;
+        dst.ny = size.height;
+        dst.buf.resize(3 * (size_t) dst.nx * dst.ny);
+        const float xr = dst.nx > 1 ? float(src.nx - 1) / (dst.nx - 1) : 0.0f;
+        const float yr = dst.ny > 1 ? float(src.ny - 1) / (dst.ny - 1) : 0.0f;
+        auto lerp = [](float a, float b, float t) { return a + (b - a) * t; };
+        for (int y = 0; y < dst.ny; ++y) {
+            for (int x = 0; x < dst.nx; ++x) {
+                const float px = x * xr, py = y * yr;
+                const int x0 = std::min(int(px), src.nx - 1), y0 = std::min(int(py), src.ny - 1);
+                const int x1 = std::min(x0 + 1, src.nx - 1), y1 = std::min(y0 + 1, src.ny - 1);
+                for (int c = 0; c < 3; ++c) {
+                    const float top = lerp(src.buf[3 * ((size_t) y0 * src.nx + x0) + c],
+                                           src.buf[3 * ((size_t) y0 * src.nx + x1) + c], px - x0);
+                    const float bot = lerp(src.buf[3 * ((size_t) y1 * src.nx + x0) + c],
+                                           src.buf[3 * ((size_t) y1 * src.nx + x1) + c], px - x0);
+                    dst.buf[3 * ((size_t) y * dst.nx + x) + c] = uint8_t(lerp(top, bot, py - y0));
+                }
+            }
+        }
+    }
