+                                          x * std::sin(theta) + y * std::cos(theta)};
+                for (int half = 0; half < 2; ++half) {
+                    const int index = i + half * (head_dim/2);
+                    GGML_ASSERT(std::fabs(((float *) out->data)[index] - expected[half]) < 1e-4f);
+                    GGML_ASSERT(std::fabs(((float *) inplace->data)[index] - expected[half]) < 1e-4f);
+                }
+            }
+        }
+        printf("vision RoPE out-of-place/in-place: PASS\n");
+    }
+
     ggml_free(ctx0);

     return 0;
diff --git a/examples/mtmd/test-glm-ocr.py b/examples/mtmd/test-glm-ocr.py
new file mode 100644
index 00000000..3630fe0d
--- /dev/null
+++ b/examples/mtmd/test-glm-ocr.py
@@ -0,0 +1,157 @@
+#!/usr/bin/env python3
+"""Real-model GLM-OCR API regression. Requires Pillow and local GGUFs, no downloads.
+
+Run once with a reference llama-server, then with the candidate and
+--reference-results pointing at the reference results.json. Servers run serially.
+Generated synthetic documents, server log and measured outputs go in --output.
+"""
+import argparse
+import base64
+import json
+import pathlib
+import re
+import socket
+import subprocess
+import time
+import unicodedata
+import urllib.error
+import urllib.request
+
+from PIL import Image, ImageDraw, ImageFont
+
+
+def canonical(text):
+    return " ".join(unicodedata.normalize("NFC", text).casefold().split())
+
+
+def fixtures(output, font_path):
+    cases = [
+        ("smoke", (672, 280), ["DOC OCR TEST 123"], ["DOC OCR TEST 123"]),
+        ("invoice", (840, 1008), [
+            "RECHNUNG NR. 2026-1042", "Müller & Söhne GmbH",
+            "Königstraße 17, 80331 München", "Kunde: Jörg Weiß",
+            "Datum: 09.03.2026", "Fällig: 23.03.2026", "",
+            "Büromaterial: 100,00 EUR", "Versand: 5,00 EUR",
+            "Netto: 105,00 EUR", "MwSt. 19%: 19,95 EUR",
+            "Gesamt: 124,95 EUR", "Vielen Dank für Ihren Auftrag!",
+        ], ["2026-1042", "Müller & Söhne GmbH", "Königstraße 17, 80331 München",
+            "Jörg Weiß", "09.03.2026", "23.03.2026", "Büromaterial: 100,00 EUR",
+            "Versand: 5,00 EUR", "Netto: 105,00 EUR", "MwSt. 19%: 19,95 EUR",
+            "Gesamt: 124,95 EUR"]),
+        ("table", (1008, 756), [
+            "LAGERBESTAND - 09.03.2026", "Artikel       Menge     Preis",
+            "Bleistift       12      0,80 EUR", "Notizbuch        3      4,50 EUR",
+            "Ordner           5      2,20 EUR", "", "Prüfung: Käthe Groß",
+            "Standort: Köln, Gebäude B", "Hinweis: Nur ungeöffnete Ware zählen.",
+        ], ["09.03.2026", "Bleistift 12 0,80 EUR", "Notizbuch 3 4,50 EUR",
+            "Ordner 5 2,20 EUR", "Käthe Groß", "Köln", "Gebäude B",
+            "ungeöffnete Ware"]),
+    ]
+    for name, size, lines, expected in cases:
+        image = Image.new("RGB", size, "white")
+        draw = ImageDraw.Draw(image)
+        font = ImageFont.truetype(font_path, 32 if name != "smoke" else 40)
+        for i, line in enumerate(lines):
+            draw.text((36, 40 + i * 62), line, font=font, fill="black")
+        image.save(output / (name + ".png"))
+        yield name, size, expected
+
+
+def request(url, body=None):
+    data = None if body is None else json.dumps(body).encode()
+    req = urllib.request.Request(url, data, {"Content-Type": "application/json"})
+    with urllib.request.urlopen(req, timeout=600) as response:
+        return json.load(response)
+
+
+def memory(pid):
+    # Linux process RSS high-water mark includes startup and completed requests.
+    status = pathlib.Path(f"/proc/{pid}/status").read_text()
+    return {line.split(":")[0]: int(line.split()[1]) for line in status.splitlines()
+            if line.startswith(("VmRSS:", "VmHWM:"))}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--server", required=True, type=pathlib.Path)
+    parser.add_argument("--model", required=True, type=pathlib.Path)
+    parser.add_argument("--mmproj", required=True, type=pathlib.Path)
+    parser.add_argument("--output", required=True, type=pathlib.Path)
+    parser.add_argument("--reference-results", type=pathlib.Path)
+    parser.add_argument("--font", default="/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf")
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=True)
+    cases = list(fixtures(args.output, args.font))
+    with socket.socket() as sock:
+        sock.bind(("127.0.0.1", 0))
+        port = sock.getsockname()[1]
+    cmd = [str(args.server.resolve()), "-m", str(args.model.resolve()),
+           "--mmproj", str(args.mmproj.resolve()), "--host", "127.0.0.1",
+           "--port", str(port), "-ngl", "0", "--no-mmproj-offload",
+           "-t", "4", "-tb", "4", "-c", "4096", "-b", "256", "-ub", "256",
+           "--parallel", "1", "--flash-attn", "off", "--no-warmup",
+           "--image-max-tokens", "1024", "--jinja"]
+    results = {"command": cmd, "cases": []}
+    failures = []
+    start = time.monotonic()
+    with (args.output / "server.log").open("w") as log:
+        proc = subprocess.Popen(cmd, stdout=log, stderr=subprocess.STDOUT)
+        try:
+            url = f"http://127.0.0.1:{port}"
+            while True:
+                if proc.poll() is not None:
+                    raise RuntimeError(f"server exited {proc.returncode}; see {args.output / 'server.log'}")
+                try:
+                    request(url + "/health")
+                    break
+                except (urllib.error.URLError, ConnectionError):
+                    if time.monotonic() - start > 300:
+                        raise RuntimeError("server startup timed out")
+                    time.sleep(0.25)
+            results["startup_seconds"] = time.monotonic() - start
+            for name, size, expected in cases:
+                encoded = base64.b64encode((args.output / (name + ".png")).read_bytes()).decode()
+                body = {"model": "glm", "messages": [{"role": "user", "content": [
+                    {"type": "image_url", "image_url": {"url": "data:image/png;base64," + encoded}},
+                    {"type": "text", "text": "Text Recognition:"},
+                ]}], "temperature": 0, "seed": 42, "top_k": 1, "top_p": 1,
+                    "min_p": 0, "repeat_penalty": 1, "max_tokens": 512, "cache_prompt": False,
+                    "chat_template_kwargs": {"enable_thinking": False}}
+                prompt = request(url + "/apply-template", {"messages": body["messages"],
+                    "chat_template_kwargs": body["chat_template_kwargs"]})
+                start_request = time.monotonic()
+                response = request(url + "/v1/chat/completions", body)
+                elapsed = time.monotonic() - start_request
+                choice = response["choices"][0]
+                text = choice["message"].get("content") or ""
+                missing = [item for item in expected if canonical(item) not in canonical(text)]
+                if missing or choice["finish_reason"] != "stop":
+                    failures.append({"case": name, "missing": missing, "finish_reason": choice["finish_reason"]})
+                results["cases"].append({"name": name, "image_size": size, "expected": expected,
+                    "text": text, "missing": missing, "wall_seconds": elapsed,
+                    "memory_kib": memory(proc.pid), "prompt": prompt, "response": response})
+                print(name, f"{elapsed:.3f}s", results["cases"][-1]["memory_kib"], repr(text), flush=True)
+        finally:
+            proc.terminate()
+            try:
+                proc.wait(timeout=15)
+            except subprocess.TimeoutExpired:
+                proc.kill()
+                proc.wait()
+            results["failures"] = failures
+            (args.output / "results.json").write_text(json.dumps(results, ensure_ascii=False, indent=2) + "\n")
+    if args.reference_results:
+        reference = json.loads(args.reference_results.read_text())
+        assert [c["name"] for c in reference["cases"]] == [c["name"] for c in results["cases"]]
+        for ref, candidate in zip(reference["cases"], results["cases"]):
+            # The server's per-process media ID is replaced by image embeddings, not tokenized.
+            prompt = lambda c: re.sub(r"<__media_[A-Za-z0-9]+__>", "<__media__>", c["prompt"]["prompt"])
+            assert prompt(ref) == prompt(candidate), "rendered prompt differs from reference"
+            print(ref["name"], "same normalized OCR:", canonical(ref["text"]) == canonical(candidate["text"]),
+                  "reference missing:", ref["missing"], "candidate missing:", candidate["missing"])
+    assert not failures, failures
+    print("PASS: GLM-OCR synthetic API regression")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/examples/mtmd/test-mtmd-pos.cpp b/examples/mtmd/test-mtmd-pos.cpp
new file mode 100644
index 00000000..ac8e09f2
--- /dev/null
+++ b/examples/mtmd/test-mtmd-pos.cpp
@@ -0,0 +1,40 @@
+#include "mtmd.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <utility>
+
+static void check_positions(json image, llama_pos expected) {
+    json input = {{"type", MTMD_INPUT_CHUNK_TYPE_IMAGE}, {"tokens_image", image}};
+    auto * chunk = mtmd_input_chunk_from_json(input);
+    const size_t n_tokens = image["nx"].get<size_t>() * image["ny"].get<size_t>();
+    GGML_ASSERT(mtmd_input_chunk_get_n_tokens(chunk) == n_tokens);
+    GGML_ASSERT(mtmd_input_chunk_get_n_pos(chunk) == expected);
+
+    // llama-server copies image chunks into its prompt cache and may serialize them.
+    auto * copy = mtmd_input_chunk_copy(chunk);
+    mtmd_input_chunk_free(chunk);
+    GGML_ASSERT(mtmd_input_chunk_get_n_pos(copy) == expected);
+    mtmd_input_chunk_free_raw_data(copy);
+    json cached;
+    mtmd_input_chunk_to_json(copy, cached);
+    mtmd_input_chunk_free(copy);
+    auto * restored = mtmd_input_chunk_from_json(cached);
+    GGML_ASSERT(mtmd_input_chunk_get_n_tokens(restored) == n_tokens);
+    GGML_ASSERT(mtmd_input_chunk_get_n_pos(restored) == expected);
+    mtmd_input_chunk_free(restored);
+}
+
+int main() {
+    // GLM's post-image text must start beyond both spatial axes, not at t + 1.
+    for (const auto & size : {std::pair<int, int>{29, 35}, {35, 29}, {9, 1}}) {
+        const int span = std::max(size.first, size.second);
+        check_positions({{"nx", size.first}, {"ny", size.second},
+                         {"use_mrope_pos", true}, {"mrope_pos_span", span}}, span);
+    }
+    // Existing Qwen M-RoPE and ordinary vision counting are unchanged.
+    check_positions({{"nx", 29}, {"ny", 35}, {"use_mrope_pos", true}}, 1);
+    check_positions({{"nx", 29}, {"ny", 35}, {"use_mrope_pos", false}}, 1015);
+    check_positions({{"nx", 4}, {"ny", 7}}, 28);
+    std::puts("PASS: media position spans, clone and cache round-trip");
+}
