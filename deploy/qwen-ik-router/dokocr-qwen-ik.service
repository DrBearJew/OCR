[Unit]
Description=Dok OCR metadata ik_llama.cpp sidecar
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ocr
Environment=QWEN_IK_PUBLIC_HOST=172.18.0.1
Environment=QWEN_IK_PUBLIC_PORT=18082
Environment=QWEN_IK_CHILD_HOST=127.0.0.1
Environment=QWEN_IK_CHILD_PORT=18083
Environment=QWEN_IK_BINARY=/root/ik_llama.cpp/build/bin/llama-server
Environment=QWEN_IK_MODEL=/root/llm-models/gemma-4-E2B-it-qat-q4_0-gguf/gemma-4-E2B_q4_0-it.gguf
Environment=QWEN_IK_MODEL_ID=gemma-4-e2b-it-qat-q4_0
Environment=QWEN_IK_ALIASES=metadata,metadata-model,gemma-4-e2b-it-qat-q4_0,gemma-e2b,qwen-mtp,qwen3.5-2b,qwen
Environment=QWEN_IK_CHAT_TEMPLATE_FILE=/root/llm-models/gemma-4-E2B-it-qat-q4_0-gguf/google-gemma4-E2B-chat_template-main.jinja
Environment=QWEN_IK_SPEC_TYPE=ngram-mod:n_max=16,n_min=0,ngram_size_n=40
Environment=QWEN_IK_CTX_SIZE=8192
Environment=QWEN_IK_BATCH_SIZE=1024
Environment=QWEN_IK_UBATCH_SIZE=512
Environment=QWEN_IK_RUN_TIME_REPACK=0
Environment="QWEN_IK_EXTRA_ARGS=--jinja --override-kv tokenizer.ggml.add_bos_token=bool:false --flash-attn on --merge-qkv"
Environment=QWEN_IK_CACHE_RAM=0
ExecStart=/usr/bin/python3 /opt/ocr/deploy/qwen-ik-router/qwen_ik_router.py
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
